<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 將所有請求轉發到背景 5001 Port 的 Waitress 伺服器 -->
        <rule name="ReverseProxyToWaitress" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <!-- 排除靜態檔案路徑（讓 IIS 直接處理靜態檔案效能更好，選用） -->
            <!-- <add input="{PATH_INFO}" pattern="^/(static|templates)/" negate="true" /> -->
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:5001/{R:1}" />
        </rule>
                <rule name="goodfriend">
                    <match url="^(.*)" />
                    <action type="Rewrite" url="http://127.0.0.1:5001/{R:1}" />
                </rule>
      </rules>
    </rewrite>
    
    <!-- 關閉 IIS 預設的詳細錯誤，以確保安全性 -->
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
</configuration>
